{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Django",
      "type": "shell",
      "command": "daphne -b 0.0.0.0 -p 8000 engine.asgi:application",
      "problemMatcher": []
    },
    {
      "label": "Run Vite",
      "type": "shell",
      "command": "npm run dev -- --host",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Huey",
      "type": "shell",
      "command": "python manage.py run_huey",
      "problemMatcher": []
    },
    {
      "label": "Run All (Django + Vite + Huey)",
      "dependsOn": ["Run Django", "Run Vite", "Run Huey"],
      "dependsOrder": "parallel"
    }
  ]
}
