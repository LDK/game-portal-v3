{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Django",
      "type": "debugpy",
      "request": "launch",
      "program": "/usr/local/bin/daphne",
      "args": ["-b", "0.0.0.0", "-p", "8000", "engine.asgi:application"],
      "django": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Launch Redis",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "redis-server",
      "args": [],
      "console": "integratedTerminal"
    },
    {
      "name": "Launch Huey",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["run_huey"],
      "console": "integratedTerminal"
    },
    {
      "name": "Launch Vite",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--host"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    },
    {
      "name": "Make Migrations",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["makemigrations"],
      "django": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Run Migrations",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["migrate"],
      "django": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Create Superuser",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["createsuperuser"],
      "django": true,
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Launch Django/Redis/Huey/Vite",
      "configurations": ["Launch Django", "Launch Huey", "Launch Vite"]
    }
  ]
}
